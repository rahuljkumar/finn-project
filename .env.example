OPENAI_API_KEY=
CHEAP_MODEL=gpt-4o-mini
REASONING_MODEL=gpt-4o
EMBEDDING_MODEL=text-embedding-3-small
USE_LIVE_NSE=true
AUTO_REFRESH=true
# Digest fallback uses the existing OpenAI key. Paid searches are capped to
# one request per 6 hours while NSE is unavailable.
USE_DIGEST_WEB_SEARCH=true
# Optional: defaults to REASONING_MODEL; must support Responses web_search.
# DIGEST_SEARCH_MODEL=
ALERT_VOLUME_MULTIPLE=2.0
ALERT_PRICE_MOVE_PCT=5.0
# Local default is data/finn.db. On Render, use the persistent mount:
# DB_PATH=/srv/data/finn.db
